<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="3.1.9" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="3.1.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="3.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobileApiServer.Handlers\MobileApiServer.Handlers.csproj" />
    <ProjectReference Include="..\MobileApiServer.Models\MobileApiServer.Models.csproj" />
    <ProjectReference Include="..\MobileApiServer.Services\MobileApiServer.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\ErrorMessage.en-US.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ErrorMessage.en-US.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\ErrorMessage.en-US.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessage.en-US.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>


</Project>
